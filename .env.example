# Network listener (loopback by default)
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
RELAY_AUTH_MODE=dev
RELAY_PERSISTENCE=sqlite
RELAY_DATABASE_PATH=.data/relay.db

# Set either the single-principal pair or RELAY_DEV_TOKENS_JSON.
# Never commit real values. Example shape for the JSON variable is documented in docs/setup-windows.md.
RELAY_DEV_TOKEN=
RELAY_DEV_PRINCIPAL=
RELAY_DEV_TOKENS_JSON=

# Production OAuth resource-server mode. Values must be absolute HTTPS URLs.
RELAY_OAUTH_ISSUER=
RELAY_OAUTH_RESOURCE=
RELAY_OAUTH_JWKS_URI=
RELAY_OAUTH_TENANT_CLAIM=
RELAY_OAUTH_DOCUMENTATION_URL=

# Managed PostgreSQL mode. Keep the URL in a secret manager, never in source control.
RELAY_DATABASE_URL=
RELAY_POSTGRES_SSL_MODE=verify-full

# Required only for the trusted stdio process launched by Secure MCP Tunnel.
RELAY_TUNNEL_PRINCIPAL=

RELAY_RATE_LIMIT_PER_MINUTE=120
